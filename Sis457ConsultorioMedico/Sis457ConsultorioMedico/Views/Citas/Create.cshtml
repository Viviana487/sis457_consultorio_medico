@model Sis457ConsultorioMedico.Models.Cita

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Cita</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label for="ciPaciente">CI del Paciente</label>
                <div class="input-group">
                    <input type="text" id="ciPaciente" class="form-control" placeholder="Buscar Paciente por Cédula de Identidad" />
                    <button type="button" class="btn btn-outline-secondary" id="btnBuscarPaciente"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label>Nombre del Paciente</label>
                <input type="text" id="nombrePaciente" class="form-control" readonly />
            </div>
            <input asp-for="IdPaciente" class="form-control" type="hidden"/>

            <script>
                document.getElementById('ciPaciente').addEventListener('blur', function () {
                    var ci = this.value;
                    if (ci) {
                        fetch(`/Pacientes/BuscarPorCI?ci=${ci}`)
                            .then(response => response.json())
                            .then(data => {
                                if (data && data.nombreCompleto) {
                                    document.getElementById('nombrePaciente').value = data.nombreCompleto;
                                } else {
                                    document.getElementById('nombrePaciente').value = "No encontrado";
                                }
                            });
                    }
                });
            </script>
            <div class="form-group">
                <label class="control-label">Doctor</label>
                <select asp-for="IdDoctor" class ="form-control" asp-items="ViewBag.IdDoctor"></select>
            </div>
            <div class="form-group">
                <label class="control-label">Especialidad</label>
                <select asp-for="IdEspecialidad" class ="form-control" asp-items="ViewBag.IdEspecialidad"></select>
            </div>
            <div class="form-group">
                <label class="control-label">Fecha</label>
                <input asp-for="Fecha" class="form-control" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Hora</label>
                <select asp-for="Hora" class="form-control">
                    <option disabled selected value="">Seleccione una hora</option>
                    <option value="09:00">09:00</option>
                    <option value="09:30">09:30</option>
                    <option value="10:00">10:00</option>
                    <option value="10:30">10:30</option>
                    <option value="11:00">11:00</option>
                    <option value="11:30">11:30</option>
                    <option value="12:00">12:00</option>
                    <option value="12:30">12:30</option>
                    <option value="13:00">13:00</option>
                    <option value="13:30">13:30</option>
                    <option value="14:00">14:00</option>
                    <option value="14:30">14:30</option>
                    <option value="15:00">15:00</option>
                    <option value="15:30">15:30</option>
                    <option value="16:00">16:00</option>
                    <option value="16:30">16:30</option>
                    <option value="17:00">17:00</option>
                </select>
                <span asp-validation-for="Hora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
